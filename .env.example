# Copier en .env pour le développement local (npm run dev, npm run spike).
# En production, ces valeurs vivent seulement dans les variables Railway.

# Service
PUBLIC_BASE_URL=https://lbc-boite-vocale.up.railway.app
PORT=8080
LOG_LEVEL=info

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DELETE_TWILIO_RECORDING=true
MIN_RECORDING_SECONDS=3
MAX_RECORDING_SECONDS=180
GREETING_AUDIO_URL_FR=
GREETING_AUDIO_URL_EN=

# Shopify
SHOPIFY_SHOP=lesbellescombines
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Chatwoot
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_AUTH=header              # header (api_access_token) | bearer (v4.19+)
CHATWOOT_INBOX_ID=                # boîte API « Boîte vocale »
CHATWOOT_EMAIL_INBOX_ID=          # optionnel, voir section 5 étape 6
CHATWOOT_TEAM_ID=                 # optionnel
REUSE_CONVERSATION_HOURS=24

# Comportement
ORDER_STATUS_MODE=redirect        # redirect | lookup
CHAT_MENTION_ENABLED=false
TRANSCRIPTION_MODE=chatwoot       # chatwoot | service
OPENAI_API_KEY=                   # seulement si TRANSCRIPTION_MODE=service
ALERT_WEBHOOK_URL=                # optionnel (webhook Slack entrant)

# Étape 0 seulement (scripts/spike.ts)
SPIKE_TEST_EMAIL=                 # adresse de test qui reçoit les courriels de la boîte courriel (ex. thierry+boitevocale@lesbellescombines.com)
SPIKE_SHOPIFY_PHONES=             # 2 ou 3 numéros de clients connus, séparés par des virgules
