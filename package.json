{
  "name": "lbc-boite-vocale",
  "version": "0.1.0",
  "private": true,
  "description": "Boîte vocale des Belles Combines : menu Twilio, enregistrement du message et dépôt dans Chatwoot avec l'audio, le numéro et le courriel de l'appelant.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "spike": "node --env-file-if-exists=.env scripts/spike.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "fastify": "^5.12.7",
    "libphonenumber-js": "^1.13.15",
    "pino": "^10.4.0",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
